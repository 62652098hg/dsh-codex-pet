{
  "name": "@local/codex-pet",
  "version": "1.0.0",
  "private": true,
  "description": "Codex ambient pet for DSH — pixel-faithful port of the Codex CLI TUI pet (states: idle/running/waiting/review, exact frame timing from codex-rs pets).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.svg", "LICENSE", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
